# Dependencies
node_modules/
functions/node_modules/

# Next.js / build output
.next/
out/
build/
dist/
coverage/

# Vercel / local caches
.vercel/
.turbo/
.cache/

# TypeScript incremental
*.tsbuildinfo

# Lockfiles (large; not useful for AI/indexing)
package-lock.json
functions/package-lock.json
yarn.lock
pnpm-lock.yaml

# Logs & debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Env / secrets (keep out of context)
.env
.env.*
!.env.example

# OS / editor junk
.DS_Store
Thumbs.db
*.pem
*.p12
*.key

# Firebase local emulators / exports (if added later)
firebase-export-*/
firestore-export/
*.export.json
*.dump
*.dump.json

# Location build artifacts (large; hurt Cursor indexing)
# Keep data/locations/world.json and extras.json searchable as source.
public/locations/**
data/locations/locations.json
